# Copy to ~/.config/vault-agents-watcher.env and edit. chmod 600 it.
VAULT_PATH=/home/you/obsidian-vault
# ANTHROPIC_API_KEY=sk-ant-...   # for @claude CLI runs

# Optional overrides (defaults shown):
# HERMES_BIN=~/.local/bin/hermes
# CLAUDE_BIN=~/.npm-global/bin/claude
# CODEX_BIN=~/.npm-global/bin/codex
# CLI_TIMEOUT_SECONDS=600          # claude/codex
# HERMES_TIMEOUT_SECONDS=1200
# SESSION_STATE_PATH=~/.local/state/vault-agents/sessions.json
# SESSION_TTL_HOURS=72             # per-note hermes session expiry
# TELEGRAM_CHAT_ID=233267520       # empty string disables pings
