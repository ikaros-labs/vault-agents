# install.sh creates ~/.config/vault-agents-watcher.env with mode 600.
# Reference options below; use absolute paths. No shell expansion is performed.
VAULT_PATH=/home/you/obsidian-vault
# ANTHROPIC_API_KEY=sk-ant-...   # for @claude CLI runs

# Optional overrides (defaults shown):
# HERMES_BIN=/home/you/.local/bin/hermes
# CLAUDE_BIN=/home/you/.npm-global/bin/claude
# CODEX_BIN=/home/you/.npm-global/bin/codex
# CLI_TIMEOUT_SECONDS=600          # claude/codex
# HERMES_TIMEOUT_SECONDS=1200
# SESSION_STATE_PATH=/home/you/.local/state/vault-agents/sessions.json
# SESSION_TTL_HOURS=72             # per-note hermes session expiry
# TELEGRAM_CHAT_ID=              # opt-in: your chat ID; empty disables pings
